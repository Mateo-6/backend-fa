{
  "AWSEBDockerrunVersion": 2,
  "containerDefinitions": [
    {
      "name": "financial-app-api",
      "image": "financial-app-api:latest",
      "essential": true,
      "memory": 512,
      "portMappings": [
        {
          "hostPort": 80,
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/elasticbeanstalk/financial-app-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "eb-docker"
        }
      }
    }
  ]
}
